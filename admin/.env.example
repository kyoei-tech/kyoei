# Copy to .env.local (git-ignored) for local development. On Vercel, set the
# same variables in the project's Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
# Server only — never prefix with NEXT_PUBLIC_. Used solely for Supabase
# Auth admin calls (creating accounts, issuing setup codes).
SUPABASE_SERVICE_ROLE_KEY=<service role key>
# Public origin of this console, used in the LINE-friendly setup links.
NEXT_PUBLIC_SITE_URL=https://<admin domain>
