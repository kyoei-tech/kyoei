// Copy to Secrets.xcconfig (git-ignored) and fill in the same values the web
// app uses (NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY).
//
// xcconfig treats "//" as a comment, so URLs must be written as
// https:/$()/... — the empty $() keeps the double slash intact.

SUPABASE_URL = https:/$()/YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY = YOUR-ANON-KEY
